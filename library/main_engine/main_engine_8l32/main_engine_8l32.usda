def Xform "main_engine_8l32" (
    prepend apiSchemas = ["MarineAssetAPI"]
    assetInfo = {
        string name = "main_engine_8l32"
        string version = "0.1.0"
    }
    kind = "component"
)
{
    token marine:class = "MainEngine"
    string marine:function = "converts fuel energy into shaft power"
    string marine:generator = "propulsion.main_engine:main_engine_8l32"
    token marine:geometryFidelity = "true"
    string marine:id = "78e10903-e30b-425b-9ea8-4e90d8b57be2"
    double marine:length = 5.74
    int marine:lodLevel = 1
    double marine:mass = 47784.994
    token marine:massSource = "rollup"
    token marine:material = "proxy"

    def Xform "EngineBlock" (
        prepend apiSchemas = ["MarineAssetAPI"]
        kind = "subcomponent"
    )
    {
        token marine:class = "EngineBlock"
        vector3d marine:explodeDir = (0, 0, 0)
        double marine:explodeDist = 0
        string marine:function = "frame and cylinder block carrying crankshaft and cylinders"
        token marine:geometryFidelity = "envelope"
        string marine:id = "0f02f155-dddf-48b4-876d-813109d978ce"
        int marine:lodLevel = 2
        double marine:mass = 30500
        token marine:massSource = "declared"
        token marine:material = "paint_engine_green"
    }

    def Xform "OilSump" (
        prepend apiSchemas = ["MarineAssetAPI"]
        kind = "subcomponent"
    )
    {
        token marine:class = "OilSump"
        rel marine:connectedTo = </main_engine_8l32/EngineBlock>
        vector3d marine:explodeDir = (0, 0, -1)
        double marine:explodeDist = 0.3025
