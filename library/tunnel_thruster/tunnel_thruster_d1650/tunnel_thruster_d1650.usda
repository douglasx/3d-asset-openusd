    def Xform "Motor" (
        prepend apiSchemas = ["MarineAssetAPI"]
        kind = "subcomponent"
    )
    {
        token marine:class = "ElectricMotor"
        rel marine:connectedTo = </tunnel_thruster_d1650/MotorStool>
