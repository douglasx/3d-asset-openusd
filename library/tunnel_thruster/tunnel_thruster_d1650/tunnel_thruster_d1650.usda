def Xform "tunnel_thruster_d1650" (
    prepend apiSchemas = ["MarineAssetAPI"]
    assetInfo = {
        string name = "tunnel_thruster_d1650"
        string version = "0.1.0"
    }
    kind = "component"
)
{
    token marine:class = "TunnelThruster"
    double marine:diameter = 1.65
    string marine:function = "produces transverse thrust at the bow for low-speed manoeuvring"
    string marine:generator = "maneuvering.tunnel_thruster:tunnel_thruster_d1650"
    token marine:geometryFidelity = "true"
    string marine:id = "1affe4ce-e39a-4cba-ab13-ee5f7e505fb2"
    double marine:length = 6.609499
    int marine:lodLevel = 1
    double marine:mass = 10954.628
    token marine:massSource = "rollup"
    token marine:material = "proxy"

    def Xform "Tunnel" (
        prepend apiSchemas = ["MarineAssetAPI"]
        kind = "subcomponent"
    )
    {
        token marine:class = "ThrusterTunnel"
        double marine:diameter = 1.69
        vector3d marine:explodeDir = (0, 0, 0)
        double marine:explodeDist = 0
        string marine:function = "transverse duct through the hull that guides the thruster jet"
        token marine:geometryFidelity = "true"
        string marine:id = "9e2e28e8-210c-4510-8c91-fc42d5d57730"
        double marine:length = 6.609499
        int marine:lodLevel = 2
        double marine:mass = 5473.688
        token marine:massSource = "computed"
        token marine:material = "steel_ah36"
    }

    def Xform "GearPod" (
        prepend apiSchemas = ["MarineAssetAPI"]
        kind = "subcomponent"
    )
    {
        token marine:class = "ThrusterGearbox"
        rel marine:connectedTo = [
            </tunnel_thruster_d1650/Tunnel>,
            </tunnel_thruster_d1650/MotorStool>,
        ]
        vector3d marine:explodeDir = (0, 1, 0)
        double marine:explodeDist = 1.2599
        string marine:function = "right-angle gear transferring motor power to the propeller shaft"
        token marine:geometryFidelity = "envelope"
        string marine:id = "2b66058a-20a8-486e-8727-b0575c525902"
        int marine:lodLevel = 2
        double marine:mass = 1400
        token marine:massSource = "declared"
        token marine:material = "paint_machinery_grey"
    }

    def Xform "Propeller" (
        prepend apiSchemas = ["MarineAssetAPI"]
        kind = "subcomponent"
    )
    {
        token marine:class = "ThrusterPropeller"
        rel marine:connectedTo = </tunnel_thruster_d1650/GearPod>
        double marine:diameter = 1.56
        vector3d marine:explodeDir = (0, -1, 0)
        double marine:explodeDist = 1.7098
        string marine:function = "fixed-pitch propeller producing transverse thrust in either direction"
        token marine:geometryFidelity = "true"
        string marine:id = "d432e360-ccf1-48d3-89bb-c87419edc705"
        int marine:lodLevel = 2
        double marine:mass = 693.667
        token marine:massSource = "computed"
        token marine:material = "bronze_nab_cu3"
    }

    def Xform "MotorStool" (
        prepend apiSchemas = ["MarineAssetAPI"]
        kind = "subcomponent"
    )
    {
        token marine:class = "Foundation"
        rel marine:connectedTo = </tunnel_thruster_d1650/Tunnel>
        double marine:diameter = 0.7
        vector3d marine:explodeDir = (0, 0, 1)
        double marine:explodeDist = 2.4297
