#usda 1.0
(
    defaultPrim = "propeller_cpp"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "propeller_cpp" (
    kind = "component"
    variants = {
        string bladeCount = "4"
    }
    prepend variantSets = "bladeCount"
)
{
    variantSet "bladeCount" = {
        "4" (
            prepend references = @./propeller_cpp_4b/propeller_cpp_4b.usda@
        ) {

        }
        "5" (
            prepend references = @./propeller_cpp_5b/propeller_cpp_5b.usda@
        ) {

        }
    }
}

